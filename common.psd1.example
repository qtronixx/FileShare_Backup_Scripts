# ШАБЛОН. Скопируйте этот файл в common.psd1 и подставьте реальный токен.
# common.psd1 в git не коммитится (см. .gitignore) — только этот .example-файл.
@{
    # --- Telegram (общие для всех задач) ---
    BotToken        = 'PUT_YOUR_BOT_TOKEN_HERE'
    ChatId          = '-1000000000000'
    MessageThreadId = '1'           # можно перекрыть в конфиге задачи своим топиком

    # SendTelegram = $false полностью отключает отправку — сообщения пишутся в лог
    # задачи вместо реальной отправки. Можно переопределить в конфиге конкретной задачи.
    SendTelegram = $true

    # Прокси для запросов к api.telegram.org, если сервер не имеет прямого выхода в
    # интернет. ProxyUrl = $null — прокси не используется.
    ProxyUrl                   = $null   # например: 'http://proxy.corp.local:3128'
    ProxyUseDefaultCredentials = $false

